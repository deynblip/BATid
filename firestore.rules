rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validProgram(p) {
      return p in ['BSCS', 'BSIT'];
    }

    function validYear(y) {
      return y in ['FIRST', 'SECOND', 'THIRD', 'FOURTH'];
    }

    function schoolEmail() {
      return request.auth.token.email.matches('.*@g\\.batstate-u\\.edu\\.ph');
    }

    // The secret codes live in config/*. Clients can never read them (no rule below).
    function validFacultyCode() {
      return request.resource.data.roleCode ==
        get(/databases/$(database)/documents/config/facultyCode).data.code;
    }

    function validCouncilCode() {
      return request.resource.data.roleCode ==
        get(/databases/$(database)/documents/config/councilCode).data.code;
    }

    // ---- Roles (read from the signed-in user's own profile) ----
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'ADMIN';
    }

    function isFaculty() {
      return signedIn() && userRole() == 'FACULTY';
    }

    function isCouncil() {
      return signedIn() && userRole() == 'COUNCIL';
    }

    function canPublish() {
      return isAdmin() || isFaculty() || isCouncil();
    }

    // ---- Announcement checks ----
    function validAnnouncement(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.body is string && d.body.size() <= 5000
        && d.category in ['ACADEMICS', 'EVENTS', 'GENERAL', 'EMERGENCY']
        && d.programs is list && d.programs.size() > 0 && d.programs.size() <= 2
        && d.programs.hasOnly(['BSCS', 'BSIT'])
        && d.yearLevel in ['ALL', 'FIRST', 'SECOND', 'THIRD', 'FOURTH']
        && d.status in ['DRAFT', 'PUBLISHED']
        && (!('linkUrl' in d) || (d.linkUrl is string && d.linkUrl.size() <= 500));
    }

    // Only FACULTY and ADMIN may use the EMERGENCY category.
    function categoryAllowed(d) {
      return d.category != 'EMERGENCY' || isFaculty() || isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // New accounts: STUDENT freely, FACULTY or COUNCIL only with the right code.
      // ADMIN can never be created here (set in the Firebase console only).
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && validProgram(request.resource.data.program)
        && validYear(request.resource.data.yearLevel)
        && schoolEmail()
        // Only the console can turn on skipEmailVerification (presentation accounts).
        && request.resource.data.get('skipEmailVerification', false) == false
        && (
          request.resource.data.role == 'STUDENT'
          || (request.resource.data.role == 'FACULTY' && validFacultyCode())
          || (request.resource.data.role == 'COUNCIL' && validCouncilCode())
        );

      // A user can change ONLY yearLevel. Role, program, name, email, section, uid are locked.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yearLevel'])
        && validYear(request.resource.data.yearLevel);

      allow delete: if false;
    }

    match /announcements/{announcementId} {
      // Everyone signed in reads PUBLISHED posts. A DRAFT is readable only by its author or ADMIN.
      allow read: if signedIn()
        && (
          resource.data.status == 'PUBLISHED'
          || resource.data.authorId == request.auth.uid
          || isAdmin()
        );

      allow create: if signedIn()
        && canPublish()
        && request.resource.data.authorId == request.auth.uid
        && validAnnouncement(request.resource.data)
        && categoryAllowed(request.resource.data);

      // ADMIN edits all. FACULTY and COUNCIL edit only their own posts.
      allow update: if signedIn()
        && (isAdmin() || (canPublish() && resource.data.authorId == request.auth.uid))
        && request.resource.data.authorId == resource.data.authorId
        && validAnnouncement(request.resource.data)
        && categoryAllowed(request.resource.data);

      allow delete: if signedIn()
        && (isAdmin() || (canPublish() && resource.data.authorId == request.auth.uid));
    }
        match /announcementImages/{announcementId} {
          function parent() {
            return get(/databases/$(database)/documents/announcements/$(announcementId)).data;
          }
          allow read: if signedIn()
            && (parent().status == 'PUBLISHED' || parent().authorId == request.auth.uid || isAdmin());
          allow create, update: if signedIn() && canPublish()
            && (parent().authorId == request.auth.uid || isAdmin())
            && request.resource.data.data is string
            && request.resource.data.data.size() < 700000;
          allow delete: if signedIn() && (isAdmin() || parent().authorId == request.auth.uid);
        }
    // config/* has NO read or write rule on purpose: only the console can touch it.
  }
}